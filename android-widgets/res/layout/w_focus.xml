<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/w_bg" android:importantForAccessibility="no"/>
    <LinearLayout android:id="@+id/w_body" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="10dp">
        <LinearLayout android:id="@+id/w_head" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/w_icon" android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="7dp" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.06" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/w_aux" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
        </LinearLayout>
        <Chronometer android:id="@+id/w_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="34sp" android:fontFamily="serif" android:visibility="gone"/>
        <TextView android:id="@+id/w_big" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="34sp" android:fontFamily="serif" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp"/>
        <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11.5sp" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="1dp"/>
        <LinearLayout android:id="@+id/w_btns" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginTop="8dp" android:gravity="center_vertical">
            <FrameLayout android:id="@+id/w_f1" android:layout_width="44dp" android:layout_height="44dp">
                <ImageView android:id="@+id/w_f1bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_circle" android:importantForAccessibility="no"/>
                <ImageView android:id="@+id/w_f1i" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="11dp"/>
            </FrameLayout>
            <FrameLayout android:id="@+id/w_f2" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="10dp">
                <ImageView android:id="@+id/w_f2bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_circle" android:importantForAccessibility="no"/>
                <ImageView android:id="@+id/w_f2i" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="11dp" android:src="@drawable/wi_open"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
