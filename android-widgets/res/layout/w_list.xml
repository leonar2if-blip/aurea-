<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/w_bg" android:importantForAccessibility="no"/>
    <LinearLayout android:id="@+id/w_body" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="10dp">
        <LinearLayout android:id="@+id/w_head" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/w_icon" android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="7dp" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.06" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/w_aux" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
        </LinearLayout>
        <TextView android:id="@+id/w_big" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="30sp" android:fontFamily="serif" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" android:visibility="gone"/>
        <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
        <LinearLayout android:id="@+id/w_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="4dp">
            <LinearLayout android:id="@+id/r1" android:layout_width="match_parent" android:layout_height="36dp"
                android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
                <ImageView android:id="@+id/r1b" android:layout_width="32dp" android:layout_height="32dp" android:padding="5dp"
                    android:layout_marginEnd="6dp" android:src="@drawable/wi_ring" android:visibility="gone"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/r1t" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
                    <TextView android:id="@+id/r1s" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="10.5sp" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end"/>
                </LinearLayout>
                <TextView android:id="@+id/r1e" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/r2" android:layout_width="match_parent" android:layout_height="36dp"
                android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
                <ImageView android:id="@+id/r2b" android:layout_width="32dp" android:layout_height="32dp" android:padding="5dp"
                    android:layout_marginEnd="6dp" android:src="@drawable/wi_ring" android:visibility="gone"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/r2t" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
                    <TextView android:id="@+id/r2s" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="10.5sp" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end"/>
                </LinearLayout>
                <TextView android:id="@+id/r2e" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/r3" android:layout_width="match_parent" android:layout_height="36dp"
                android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
                <ImageView android:id="@+id/r3b" android:layout_width="32dp" android:layout_height="32dp" android:padding="5dp"
                    android:layout_marginEnd="6dp" android:src="@drawable/wi_ring" android:visibility="gone"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/r3t" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
                    <TextView android:id="@+id/r3s" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="10.5sp" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end"/>
                </LinearLayout>
                <TextView android:id="@+id/r3e" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/r4" android:layout_width="match_parent" android:layout_height="36dp"
                android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
                <ImageView android:id="@+id/r4b" android:layout_width="32dp" android:layout_height="32dp" android:padding="5dp"
                    android:layout_marginEnd="6dp" android:src="@drawable/wi_ring" android:visibility="gone"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/r4t" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
                    <TextView android:id="@+id/r4s" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="10.5sp" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end"/>
                </LinearLayout>
                <TextView android:id="@+id/r4e" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/r5" android:layout_width="match_parent" android:layout_height="36dp"
                android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
                <ImageView android:id="@+id/r5b" android:layout_width="32dp" android:layout_height="32dp" android:padding="5dp"
                    android:layout_marginEnd="6dp" android:src="@drawable/wi_ring" android:visibility="gone"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/r5t" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
                    <TextView android:id="@+id/r5s" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="10.5sp" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end"/>
                </LinearLayout>
                <TextView android:id="@+id/r5e" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/r6" android:layout_width="match_parent" android:layout_height="36dp"
                android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
                <ImageView android:id="@+id/r6b" android:layout_width="32dp" android:layout_height="32dp" android:padding="5dp"
                    android:layout_marginEnd="6dp" android:src="@drawable/wi_ring" android:visibility="gone"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/r6t" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
                    <TextView android:id="@+id/r6s" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="10.5sp" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end"/>
                </LinearLayout>
                <TextView android:id="@+id/r6e" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/w_empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:fontFamily="sans-serif" android:maxLines="3" android:ellipsize="end" android:layout_marginTop="6dp" android:visibility="gone"/>
    </LinearLayout>
</FrameLayout>
